// PyPilot tasks for Zed on macOS and Linux. Generated by scripts/gen_zed_tasks.py;
// edit that script, not this file.
//
// Copy into your global tasks file (~/.config/zed/tasks.json) or into a
// project's .zed/tasks.json, then run them with `task: spawn`.
//
// Each task runs the `pypilot` on your PATH if there is one, and otherwise
// the copy the PyPilot Zed extension downloaded for its language server, so
// nothing else needs installing. Open a Python file once so the extension
// has downloaded it.
//
// The fix environment task runs `pypilot doctor --fix`, the same targeted fix
// as the editor's "Fix environment" button; show details runs `pypilot doctor`.
// No task passes `--path`: Zed runs tasks in the worktree root, so paths with
// spaces are never split.
[
  {
    "label": "pypilot: fix environment (only what doctor found)",
    "command": "sh",
    "args": [
      "-c",
      "p=$(command -v pypilot 2>/dev/null); if [ -z \"$p\" ]; then for d in \"${XDG_DATA_HOME:-$HOME/.local/share}/zed\" \"$HOME/Library/Application Support/Zed\" \"$HOME/.var/app/dev.zed.Zed/data/zed\"; do for f in \"$d\"/extensions/work/pypilot-language-server/pypilot-*/pypilot; do [ -x \"$f\" ] && p=$f; done; done; fi; if [ -z \"$p\" ]; then echo \"PyPilot could not find the pypilot command. Open a Python file so the Zed extension downloads it, or install it with: pip install pypilot-cli\" >&2; exit 1; fi; exec \"$p\" \"$@\"",
      "pypilot",
      "doctor",
      "--fix"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "save": "all",
    "reveal": "always"
  },
